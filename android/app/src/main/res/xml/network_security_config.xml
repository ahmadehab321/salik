<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed because the user's own Stremio server on the home network
     (e.g. http://192.168.1.10:8080) has no certificate. All streaming platforms use https anyway. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
